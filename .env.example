# ============================================================================
# ML-ENHANCED TRADING BOT - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
#
# This is a template file. Copy this to .env and fill in your actual values.
#
# Command: cp .env.example .env
#
# ============================================================================

# Anthropic (Claude) API Key
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Coinbase Cloud API Key
# Get from: https://portal.cdp.coinbase.com/
COINBASE_API_KEY=organizations/your-org-id/apiKeys/your-key-id

# Coinbase Private Key (use \n for newlines, keep double quotes)
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END EC PRIVATE KEY-----"
